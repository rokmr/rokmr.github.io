{
  "name": "rohit-vision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs",
    "preview": "vite preview",
    "serve": "npm run build && npx --yes serve dist -l 8000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run content:test",
    "test:watch": "vitest",
    "content:init": "node scripts/content.mjs init",
    "content:check": "node scripts/content.mjs check",
    "content:export": "node scripts/content.mjs export",
    "content:test": "node --test scripts/content.test.mjs",
    "resume:pdf": "node scripts/build-resume.mjs",
    "test:browser": "node scripts/check-browser.mjs && node scripts/check-interactions.mjs",
    "test:design": "node scripts/check-design-system.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
